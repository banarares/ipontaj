APP_NAME=iPontaj
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BILLING_ENABLED=false
SELF_HOSTED_SEAT_LIMIT=15
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEAM_PRICE=
STRIPE_PORTAL_CONFIGURATION=
CASHIER_CURRENCY=ron
CASHIER_CURRENCY_LOCALE=ro_RO

# Launch verification: complete from actual contracts; never mark these merely to bypass a check.
LEGAL_PUBLICATION_APPROVED=false
LEGAL_HOSTING_ENTITY=
LEGAL_DATA_LOCATION=
LEGAL_BACKUP_RETENTION_DAYS=0
LEGAL_LOG_RETENTION_DAYS=0
LEGAL_RETENTION_APPROVED=false
LEGAL_HOSTING_DPA_CONFIRMED=false
LEGAL_STRIPE_DPA_CONFIRMED=false
LEGAL_CAEN_CONFIRMED=false
LEGAL_INVOICING_CONFIRMED=false
LEGAL_OPERATIONS_CONFIRMED=false
LEGAL_MAIL_DELIVERY_CONFIRMED=false
LEGAL_CONSUMER_FLOW_CONFIRMED=false
