APP_NAME=iPontaj
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BILLING_ENABLED=false
SELF_HOSTED_SEAT_LIMIT=15
# Temporary demo: one login user per workspace, removed on exit or expiry.
DEMO_SESSION_MINUTES=60
DEMO_MAX_WORKSPACES=20
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEAM_PRICE=
STRIPE_PORTAL_CONFIGURATION=
CASHIER_CURRENCY=ron
CASHIER_CURRENCY_LOCALE=ro_RO

# Launch verification: complete from actual contracts; never mark these merely to bypass a check.
# See docs/LEGAL_ENV.md for evidence and docs/CPANEL_DEPLOY.md for ea-php83 cron commands.
# LEGAL_LOG_RETENTION_DAYS is a policy value; configure actual log rotation/expiry separately.
LEGAL_PUBLICATION_APPROVED=false
LEGAL_HOSTING_ENTITY=
LEGAL_DATA_LOCATION=
LEGAL_BACKUP_RETENTION_DAYS=0
LEGAL_LOG_RETENTION_DAYS=0
LEGAL_RETENTION_APPROVED=false
LEGAL_HOSTING_DPA_CONFIRMED=false
LEGAL_STRIPE_DPA_CONFIRMED=false
LEGAL_CAEN_CONFIRMED=false
LEGAL_INVOICING_CONFIRMED=false
LEGAL_OPERATIONS_CONFIRMED=false
LEGAL_MAIL_DELIVERY_CONFIRMED=false
LEGAL_CONSUMER_FLOW_CONFIRMED=false

# Cloudflare reverse proxy: trust only the official ranges (or an explicit CIDR list).
CLOUDFLARE_ENABLED=false
# CLOUDFLARE_TRUSTED_PROXIES=173.245.48.0/20,2400:cb00::/32

# Managed Turnstile widget for login, registration and contact. Independent of proxy mode.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Defaults to the hostname in APP_URL. Include every hostname allowed on the widget.
# TURNSTILE_HOSTNAMES=ipontaj.ro,www.ipontaj.ro

# Optional, public Web Analytics token. The beacon loads only after consent.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=
# Optional Google Tag Manager container (GTM-XXXXXXX). Loads only after consent, on public pages.
GOOGLE_TAG_MANAGER_ID=

# Enable indexing only on the production domain after the launch checks.
SEO_INDEXABLE=false
# SEO_CANONICAL_URL=https://ipontaj.ro
GOOGLE_SITE_VERIFICATION=
